# =========================================================
# Railway 배포 시 → Railway 대시보드 환경변수에 입력
# 로컬 개발 시 → 이 파일을 .env로 복사 후 값 입력
# =========================================================

# --- 필수 (미설정 시 앱 기동 불가) ---
POSTGRES_PASSWORD=your_db_password
SECRET_KEY=your_32_char_random_secret
ACCESS_SECRET_KEY=your_32_char_random_secret
REFRESH_SECRET_KEY=your_32_char_random_secret

# 시크릿 키 생성: python -c "import secrets; print(secrets.token_hex(32))"

# --- DB (Railway PostgreSQL 사용 시 DATABASE_URL 하나만 설정) ---
DATABASE_URL=postgresql://user:pass@host:port/db
# 로컬 개발 시 (위 DATABASE_URL 대신 개별 항목 사용)
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_DB=agent_db

# --- Redis (Railway Redis 사용 시 REDIS_URL 하나만 설정) ---
REDIS_URL=redis://default:pass@host:port
# 로컬 개발 시
# REDIS_HOST=localhost
# REDIS_PORT=6379

# --- OpenAI ---
AI_API_KEY=sk-...

# --- 파일 저장소: Cloudflare R2 (추천, 무료 10GB) ---
R2_ENABLED=true
R2_BUCKET_NAME=planova-storage
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key

# --- 앱 설정 ---
ENVIRONMENT=production
FRONTEND_URL=https://planova.kr
STATIC_DIR=./frontend/dist

# --- 이메일 (Gmail 앱 비밀번호) ---
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
FROM_EMAIL=noreply@planova.kr

# --- Kakao OAuth (선택) ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://api.planova.kr/api/v1/auth/kakao/callback

# --- 결제 (선택) ---
IAMPORT_WEBHOOK_SECRET=
IAMPORT_API_KEY=
IAMPORT_API_SECRET=
