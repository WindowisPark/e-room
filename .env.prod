# .env.prod

# PostgreSQL 연결 정보 (RDS 기준)
DATABASE_URI=postgresql://postgres:password123@eroom-db.c5musscuevqp.ap-northeast-2.rds.amazonaws.com/agent_db

# CORS 설정 (필요시)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "https://your-frontend-domain.com"]

# JWT 설정
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis 설정 (ElastiCache Redis or 호스트명 기준)
REDIS_HOST=eroom-redis.ef3ltm.0001.apn2.cache.amazonaws.com
REDIS_PORT=6379
