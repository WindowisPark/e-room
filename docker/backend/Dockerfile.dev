FROM python:3.10

WORKDIR /app

# 시스템 패키지 설치 (OCR, PDF, DB 관련)
RUN apt-get update && apt-get install -y \
    tesseract-ocr \
    tesseract-ocr-kor \
    poppler-utils \
    libpq-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# requirements 분리 설치
COPY requirements/base.txt ./requirements/
RUN pip install --upgrade pip \
    && pip install --prefer-binary --use-deprecated=legacy-resolver -r requirements/base.txt

COPY requirements/dev.txt ./requirements/
RUN pip install --prefer-binary --use-deprecated=legacy-resolver -r requirements/dev.txt

# 앱 복사
COPY . .

# 핫리로딩 포함 실행
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
