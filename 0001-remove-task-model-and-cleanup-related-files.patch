+    if "error" in result:
+        raise HTTPException(
+            status_code=status.HTTP_403_FORBIDDEN,
+            detail=result["error"]
+        )
+
+@router.get("/pdf/{pdf_id}", response_model=AnnotationList)
+async def get_annotations(
