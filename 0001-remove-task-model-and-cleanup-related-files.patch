+async def get_pdf_annotations(db: Session, pdf_id: int, user_id: int, page: Optional[int] = None) -> Dict[str, Any]:
+    """PDF 주석 목록 조회"""
+    # PDF 파일 존재 여부 및 접근 권한 확인
+    pdf_file = get_pdf_by_id(db=db, pdf_id=pdf_id)
+    if not pdf_file:
+        return {"error": "PDF 파일을 찾을 수 없습니다"}
