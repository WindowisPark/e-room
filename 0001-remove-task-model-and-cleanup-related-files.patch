+                return 'dummy_token'
+                
+            url = "https://api.iamport.kr/users/getToken"
+            headers = {'Content-Type': 'application/json'}
+            data = {
+                'imp_key': self.imp_key,
+                'imp_secret': self.imp_secret
+            }
+            
+            response = requests.post(url, headers=headers, json=data)
