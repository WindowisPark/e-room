+                cache_service.set_json(cache_key, result, ttl, prefix)
+                
+                return result
+            
+            # async 함수인지 여부에 따라 적절한 래퍼 반환
+            if asyncio.iscoroutinefunction(func):
+                return async_wrapper
+            return sync_wrapper
+        
+        return decorator        
