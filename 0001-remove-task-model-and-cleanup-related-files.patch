+                if exclude_user is None or user_id != exclude_user:
+                    await connection.send_json(message)
+        
+        # 직접 연결되지 않은 클라이언트를 위해 Redis에도 발행
+        await self.redis.publish(f"room:{room_id}", json.dumps({
+            **message,
+            "exclude_user": exclude_user
+        }))
