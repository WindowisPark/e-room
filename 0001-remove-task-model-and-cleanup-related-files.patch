+    if not db_tag or db_tag.user_id != user_id:
+        return False
+    
+    db.delete(db_tag)
+    db.commit()
+    return True
+
+def process_mentions(db: Session, tag_id: int, usernames: List[str]) -> None:
+    """태그/주석 내 멘션된 사용자들 처리"""
